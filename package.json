{
  "name": "arald",
  "private": true,
  "version": "0.1.0",
  "description": "ARALD: a distributed, content-centric, delay-tolerant network that needs no Internet infrastructure.",
  "workspaces": [
    "node"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build -w node",
    "simulate": "tsx tools/simulator/cli.ts",
    "scenario-model": "tsx tools/scenario-model/cli.ts",
    "gateway:demo": "tsx gateway/local-services/cli.ts",
    "hub": "tsx nomad-hub/cli.ts",
    "portal:sync": "tsx arald-backend/sync.ts",
    "portal:local": "tsx local-portal/cli.ts",
    "whatsapp-relay": "tsx whatsapp-relay/cli.ts",
    "email-relay": "tsx email-relay/cli.ts",
    "webhook-relay": "tsx webhook-relay/cli.ts",
    "discovery-service": "tsx discovery-service/cli.ts",
    "build:portable": "tsx packaging/build-sea.ts"
  },
  "dependencies": {
    "dbus-next": "^0.10.2",
    "pg": "^8.13.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "overrides": {
    "node-gyp": "^13.0.2",
    "tar": "^7.5.22"
  },
