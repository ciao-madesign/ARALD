{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true, "noUncheckedIndexedAccess": false
  },
  "include": ["./*.ts", "../scenario-model/*.ts"],
  "exclude": ["../scenario-model/cli.ts"]
}
